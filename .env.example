# Copier ce fichier en ".env" et adapter les valeurs à ta machine.
# Ne jamais committer le fichier ".env" (voir .gitignore).

SECRET_KEY=change-me-in-production

# IMPORTANT (sécurité) : ne JAMAIS mettre "true" en production. Le
# débogueur Werkzeug (activé par ce mode) permet l'exécution de code
# Python arbitraire depuis le navigateur si une erreur survient.
FLASK_DEBUG=false

# Serveur LanguageTool (local ou distant)
LANGUAGETOOL_URL=http://localhost:8081/v2/check

# Chemin vers l'exécutable Tesseract.
# Laisser vide sur Linux/Mac si tesseract est déjà dans le PATH système.
# Exemple Windows : C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Taille max des images uploadées pour l'OCR (en Mo)
MAX_UPLOAD_MB=5

# Longueur max (en caractères) acceptée pour un texte envoyé aux routes
# de correction/traduction/reformulation.
MAX_TEXT_LENGTH=5000

# Rate limiting (protège le quota Groq et le CPU OCR/LanguageTool contre
# le spam). Désactiver uniquement pour du débogage local.
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_AI=20 per minute
RATELIMIT_OCR=10 per minute

# Couche IA (optionnelle) : Groq (https://console.groq.com/keys)
# Laisser vide pour désactiver l'IA -- l'app fonctionne quand même,
# avec un repli automatique sur les fonctionnalités par règles.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
